# Copy these values into the Windows service's environment configuration.
# These are examples; use the approved company shares and internal DNS name.
SKF_PUBLIC_URL=https://skf.intranet.example
SKF_ALLOWED_HOSTS=skf.intranet.example

# This folder must contain selectable month folders directly, e.g. 7-Temmuz under 2026.
SKF_DATA_ROOT=\\FILESERVER\Share\DistributionSystemUsage\2026

# Directories containing Excel files; the app lists only files in these folders.
SKF_SYSTEM_USAGE_ROOT=\\FILESERVER\Share\SystemUsageReference
SKF_OUR_INVOICES_ROOT=\\FILESERVER\Share\OurInvoices

# Optional. If unset, Kesin Liste is searched inside the selected period folder.
SKF_ENO_ROOT=
